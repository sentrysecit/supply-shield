# Copy this file to .env and adjust as needed.

# Runtime environment: "development" (console logs) or "production" (JSON logs).
SUPPLY_SHIELD_ENVIRONMENT=development

# Minimum log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
SUPPLY_SHIELD_LOG_LEVEL=INFO

# In-memory cache capacity and time-to-live, in seconds.
# Metadata and decisions expire within minutes; findings stay for hours.
SUPPLY_SHIELD_CACHE_MAX_ENTRIES=1024
SUPPLY_SHIELD_CACHE_METADATA_TTL_SECONDS=300
SUPPLY_SHIELD_CACHE_FINDINGS_TTL_SECONDS=21600
SUPPLY_SHIELD_CACHE_DECISIONS_TTL_SECONDS=300

# Heuristic risk rule thresholds.
SUPPLY_SHIELD_HEURISTICS_COOLDOWN_DAYS=30
SUPPLY_SHIELD_HEURISTICS_NEW_PACKAGE_DAYS=90
SUPPLY_SHIELD_HEURISTICS_NEW_PACKAGE_MAX_VERSIONS=5

# Base de datos PostgreSQL (SQLAlchemy async, asyncpg driver).
SUPPLY_SHIELD_DATABASE_URL=postgresql+asyncpg://supply_shield:supply_shield@localhost:5432/supply_shield

# Redis para caché y almacenamiento de artefactos.
SUPPLY_SHIELD_REDIS_URL=redis://localhost:6379/0

# Directorio para artefactos descargados (caché de disco direccionado por hash).
SUPPLY_SHIELD_ARTIFACTS_DIR=.artifacts

# Path to the projects YAML file (project names + hashed tokens for auth).
SUPPLY_SHIELD_PROJECTS_FILE=config/projects.yaml

# Upstream registry client (D1-1). The host allowlist is the SSRF boundary: the
# proxy only opens connections to the hosts listed here. Provide a JSON array to
# override, e.g. SUPPLY_SHIELD_UPSTREAM_HOSTS='["registry.npmjs.org"]'.
SUPPLY_SHIELD_UPSTREAM_HOSTS=["registry.npmjs.org","pypi.org","files.pythonhosted.org"]

# Maximum bytes of a single upstream response; larger downloads are aborted.
SUPPLY_SHIELD_UPSTREAM_MAX_RESPONSE_BYTES=536870912

# Timeouts, in seconds, for opening and reading upstream connections.
SUPPLY_SHIELD_UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
SUPPLY_SHIELD_UPSTREAM_READ_TIMEOUT_SECONDS=30

# Retries on transient upstream failures: number of attempts and exponential
# backoff factor (wait = backoff_factor * 2**attempt seconds).
SUPPLY_SHIELD_UPSTREAM_MAX_RETRIES=3
SUPPLY_SHIELD_UPSTREAM_BACKOFF_FACTOR=0.5

# Maximum simultaneous upstream connections kept in the shared pool.
SUPPLY_SHIELD_UPSTREAM_MAX_CONNECTIONS=100
